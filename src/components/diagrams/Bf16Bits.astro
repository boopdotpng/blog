  figcaption { margin-top: 12px; font-size: 10px; }
  @media (max-width: 480px) { .bf16 { padding: 12px; } .bit-strip { gap: 5px; } .bit-strip b { font-size: 14px; letter-spacing: 0; } .bit-strip span, .bit-strip small { font-size: 10px; } }
</style>
