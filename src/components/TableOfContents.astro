---
/**
 * Desktop-only table of contents that stays out of the way while reading.
 *
 * At rest it is a faint column of tick marks in the left margin, one per
 * heading: the current section's tick is longer and accent-coloured, and ticks
 * for sections already passed are darker, so it doubles as a progress bar.
 * Hovering or tabbing into it slides out a card with the heading titles.
 */
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const { headings } = Astro.props;
const baseDepth = Math.min(...headings.map(heading => heading.depth));
// Two levels is plenty for a rail; deeper headings would just be noise.
const items = headings.filter(heading => heading.depth <= baseDepth + 1);
---

<nav class="toc" aria-label="Table of contents">
  <ol>
    {items.map(heading => (
      <li class:list={{ 'is-sub': heading.depth > baseDepth }}>
        <a target="_self" href={`#${heading.slug}`}>
          <span class="toc-tick" aria-hidden="true"></span>
          <span class="toc-label">{heading.text}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .toc { display: none; }

  @media (min-width: 1100px) {
    .toc {
      display: block;
      position: fixed;
      top: 50%;
      /* Hug the window edge, as far from the reading column as possible. */
      left: 1.25rem;
      z-index: 40;
      translate: 0 -50%;
      max-height: 70dvh;
      font-family: var(--font-mono);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.4s ease, visibility 0.4s;
    }

    /* Only appears once the reader is past the title block. */
    .toc.is-ready { opacity: 1; visibility: visible; }

    ol {
      list-style: none;
      margin: 0;
      padding: 0.75rem 0.9rem 0.75rem 0.5rem;
      border-radius: 10px;
      border: 1px solid transparent;
      max-height: 70dvh;
      overflow-y: auto;
      scrollbar-width: none;
      transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }

    .toc:is(:hover, :focus-within) ol {
      background: var(--bg);
      border-color: var(--border-soft);
      box-shadow: 0 12px 36px rgba(var(--shadow-rgb), 0.1);
    }

    li { margin: 0; padding: 0; }

    a {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      padding: 0.2rem 0;
      text-decoration: none;
      color: var(--fg-subtle);
    }

    .toc-tick {
      flex: none;
      width: 22px;
      display: flex;
      justify-content: flex-end;
    }

    .toc-tick::before {
      content: '';
      display: block;
      height: 2px;
      width: 14px;
      border-radius: 2px;
      background: var(--border-strong);
      transition: width 0.3s cubic-bezier(.2, .8, .2, 1), background-color 0.3s ease;
    }

    .is-sub .toc-tick::before { width: 8px; }
    .is-read .toc-tick::before { background: var(--fg-faint); }
    a[aria-current='location'] .toc-tick::before { width: 22px; background: var(--accent); }
    a:hover .toc-tick::before { background: var(--fg); }

    .toc-label {
      max-width: 0;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
      font-size: 0.72rem;
      line-height: 1.5;
      opacity: 0;
      translate: -6px 0;
      transition: max-width 0.3s cubic-bezier(.2, .8, .2, 1), opacity 0.2s ease, translate 0.3s ease;
    }

    .is-sub .toc-label { padding-left: 0.8rem; font-size: 0.68rem; }

    .toc:is(:hover, :focus-within) .toc-label {
      max-width: 17rem;
      opacity: 1;
      translate: 0 0;
    }

    a:hover .toc-label { color: var(--fg); }
    a[aria-current='location'] .toc-label { color: var(--accent); }
  }
</style>

<script>
  const toc = document.querySelector<HTMLElement>('.toc');
  if (toc) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a')];
    const sections = links.flatMap(link => {
      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      if (!heading) return [];
      heading.tabIndex = -1;
      return [{ link, heading }];
    });
    const title = document.querySelector('.post-subline');

    let pending = false;
    let active: HTMLAnchorElement | undefined;
    const update = () => {
      pending = false;
      toc.classList.toggle('is-ready', !title || title.getBoundingClientRect().bottom < 0);
      let current = -1;
      sections.forEach((section, i) => {
        if (section.heading.getBoundingClientRect().top <= 96) current = i;
      });
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) current = sections.length - 1;
      sections.forEach((section, i) => section.link.parentElement!.classList.toggle('is-read', i < current));
      const next = sections[current]?.link;
      if (next === active) return;
      active?.removeAttribute('aria-current');
      active = next;
      active?.setAttribute('aria-current', 'location');
      // Keep the current tick in view when the rail itself has to scroll.
      if (active && !toc.matches(':hover, :focus-within')) active.scrollIntoView({ block: 'nearest' });
    };
    const schedule = () => {
      if (!pending) {
        pending = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    window.addEventListener('hashchange', schedule);
    schedule();
  }
</script>
