---
import type { CollectionEntry } from 'astro:content';
import DevPublishScript from './DevPublishScript.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
  /** Dev only: unpublished posts, listed above the index. */
  unpublished?: CollectionEntry<'blog'>[];
}
const { posts, unpublished = [] } = Astro.props as Props;
const isDev = import.meta.env.DEV;

const parseLocalDate = (dateString: string) => {
  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateString);
  if (!match) return null;
  const [, year, month, day] = match;
  return new Date(Number(year), Number(month) - 1, Number(day));
};
const formatShortDate = (date: Date) => {
  const month = date.toLocaleDateString('en-US', { month: 'short' }).toLowerCase();
  const day = String(date.getDate()).padStart(2, '0');
  return `${month} ${day} ${date.getFullYear()}`;
};

const catColors: Record<string, string> = {
  'gpu': 'var(--cat-gpu)',
  'ml': 'var(--cat-ml)',
  'hardware': 'var(--cat-hardware)',
  'tenstorrent': 'var(--cat-tenstorrent)',
  'bio': 'var(--cat-bio)',
  'misc': 'var(--cat-misc)',
};
const getCatColor = (cat: string) => catColors[cat] || 'var(--fg-soft)';
---

<section class="home">
  {isDev && (
    <div class="section dev-unpublished">
      <div class="section-header">
        <span class="section-title">// unpublished</span>
        <span class="section-rule" aria-hidden="true"></span>
        <a class="dev-new-post" href="/editor">+ new post</a>
      </div>
      <ol class="post-index">
        {unpublished.map((post) => {
          const cat = post.data.cat ?? '—';
          const date = parseLocalDate(post.data.pubDate);
          return (
            <li class="post-row has-edit" data-cat={cat} style={`--row-color: ${getCatColor(cat)}`}>
              <a href={`/blog/${post.id}`} class="post-link" target="_self">
                <span class="post-bar" aria-hidden="true"></span>
                <span class="post-num">wip</span>
                <span class="post-title">{post.data.title}</span>
                <span class="post-meta">
                  <span class="post-cat">{cat}</span>
                  <span class="post-sep" aria-hidden="true">·</span>
                  <time class="post-date" datetime={post.data.pubDate}>{date ? formatShortDate(date) : post.data.pubDate}</time>
                </span>
              </a>
              <button type="button" class="dev-row-action" data-dev-publish data-slug={post.id} data-publish="true" title="publish" aria-label="publish">↑</button>
              <a class="dev-row-action" href={`/editor?slug=${post.id}`} title="edit in the post editor" aria-label="edit">✎</a>
            </li>
          );
        })}
      </ol>
    </div>
  )}

  <div class="section">
    <div class="section-header">
      <span class="section-title">// index</span>
      <span class="section-rule" aria-hidden="true"></span>
    </div>
    <ol class="post-index">
      {posts.map((post, idx) => {
        const num = posts.length - idx;
        const hex = `0x${num.toString(16).padStart(2, '0')}`;
        const cat = post.data.cat ?? '—';
        const date = parseLocalDate(post.data.pubDate);
        const dateLabel = date ? formatShortDate(date) : post.data.pubDate;
        const year = date?.getFullYear() ?? null;
        const prevDate = idx > 0 ? parseLocalDate(posts[idx - 1].data.pubDate) : null;
        const newYear = idx > 0 && year !== null && prevDate !== null && year !== prevDate.getFullYear();

        return (
          <>
          {newYear && (
            <li class="year-row" role="presentation">
              <span class="year-label">{year}</span>
              <span class="year-rule" aria-hidden="true"></span>
            </li>
          )}
          <li class={isDev ? 'post-row has-edit' : 'post-row'} data-cat={cat} style={`--row-color: ${getCatColor(cat)}`}>
            <a href={`/blog/${post.id}`} class="post-link" target="_self">
              <span class="post-bar" aria-hidden="true"></span>
              <span class="post-num">{hex}</span>
              <span class="post-title">{post.data.title}</span>
              <span class="post-meta">
                <span class="post-cat">{cat}</span>
                <span class="post-sep" aria-hidden="true">·</span>
                <time class="post-date" datetime={post.data.pubDate}>{dateLabel}</time>
              </span>
            </a>
            {isDev && (
              <>
                <button type="button" class="dev-row-action" data-dev-publish data-slug={post.id} data-publish="false" title="unpublish" aria-label="unpublish">↓</button>
                <a class="dev-row-action" href={`/editor?slug=${post.id}`} title="edit in the post editor" aria-label="edit">✎</a>
              </>
            )}
          </li>
          </>
        );
      })}
    </ol>
  </div>
</section>
{isDev && <DevPublishScript />}

<style>
  .home {
    width: 100%;
    padding: 0.25rem 0 0;
    font-family: var(--font-mono);
  }






  /* dev only */
  .dev-new-post {
    flex-shrink: 0;
    font-size: 0.75rem;
    color: var(--fg-muted);
    text-decoration: none;
    border: 1px solid var(--border-soft);
    border-radius: 4px;
    padding: 0 0.45rem;
  }
  .dev-new-post:hover {
    color: var(--fg-strong);
    border-color: var(--border-strong);
  }

  /* ── sections ──────────────────────────────────────────── */

  .section {
    margin-bottom: 0;
  }

  .section + .section {
    margin-top: 2.25rem;
  }

  /* dev only: per-row edit link */
  .post-row.has-edit {
    display: flex;
    align-items: center;
  }
  .post-row.has-edit .post-link {
    flex: 1;
    min-width: 0;
  }
  .dev-row-action {
    flex-shrink: 0;
    margin-left: 0.15rem;
    font: inherit;
    font-size: 0.85rem;
    line-height: 1;
    color: var(--fg-faint);
    background: none;
    border: 0;
    cursor: pointer;
    text-decoration: none;
    padding: 0.2rem 0.3rem;
  }
  .post-link + .dev-row-action {
    margin-left: 0.5rem;
  }
  .dev-row-action:hover {
    color: var(--fg-strong);
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }

  .section-title {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--fg-muted);
    text-transform: lowercase;
    flex-shrink: 0;
  }

  .section-rule {
    flex: 1;
    height: 1px;
    background: var(--border-soft);
  }

  /* ── post index ────────────────────────────────────────── */

  .post-index {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-row {
    border-bottom: 1px dashed var(--border-soft);
    transition: opacity 0.15s;
  }

  .post-row:first-child {
    border-top: 1px dashed var(--border-soft);
  }

  .post-row.is-dim {
    opacity: 0.3;
  }

  .year-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.4rem 0 0.85rem;
  }

  .year-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .year-rule {
    flex: 1;
    height: 1px;
    background: var(--border-soft);
  }

  .post-link {
    display: grid;
    grid-template-columns: 3px 2.8rem minmax(0, 1fr) auto;
    gap: 0.7rem;
    align-items: center;
    padding: 0.75rem 0.5rem 0.75rem 0;
    text-decoration: none;
    color: inherit;
    transition: background 0.12s;
  }

  .post-link:hover,
  .post-link:focus-visible {
    background: var(--surface-soft);
  }

  .post-bar {
    background: var(--row-color);
    opacity: 0.55;
    transition: opacity 0.12s;
    align-self: stretch;
    border-radius: 2px;
  }

  .post-link:hover .post-bar {
    opacity: 1;
  }

  .post-num {
    font-size: 0.78rem;
    color: var(--fg-faint);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.03em;
  }

  .post-link:hover .post-num {
    color: var(--row-color);
  }

  .post-title {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--fg);
    line-height: 1.5;
    min-width: 0;
  }

  .post-link:hover .post-title {
    color: var(--fg-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: var(--fg-faint);
    white-space: nowrap;
  }

  .post-cat {
    color: var(--row-color);
    text-transform: lowercase;
    font-weight: 500;
  }

  .post-sep {
    color: var(--border-strong);
  }

  .post-date {
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }

  /* ── responsive ────────────────────────────────────────── */

  @media (min-width: 1101px) and (max-height: 950px) {
    .post-link { padding-block: 0.6rem; }
  }

  @media (min-width: 761px) and (max-width: 1100px) {
    .post-link {
      grid-template-columns: 3px 2.8rem minmax(0, 1fr);
      row-gap: 0.3rem;
    }

    .post-bar { grid-row: 1 / 3; }
    .post-num { grid-row: 1 / 3; }
    .post-meta { grid-column: 3; }
  }

  @media (max-width: 760px) {
    .home {
      padding: 0.25rem 0 0;
    }

    .post-link {
      grid-template-columns: 4px 1fr;
      grid-template-rows: auto auto;
      gap: 0.25rem 0.7rem;
    }

    .post-bar {
      grid-row: 1 / 3;
    }

    .post-num {
      display: none;
    }

    .post-meta {
      grid-column: 2;
      grid-row: 2;
      font-size: 0.7rem;
    }
  }
</style>
