---
import type { CollectionEntry } from 'astro:content';
import DevPublishScript from './DevPublishScript.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
  /** Dev only: unpublished posts, listed above the index. */
  unpublished?: CollectionEntry<'blog'>[];
}
const { posts, unpublished = [] } = Astro.props as Props;
const isDev = import.meta.env.DEV;

const parseLocalDate = (dateString: string) => {
  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateString);
  if (!match) return null;
  const [, year, month, day] = match;
  return new Date(Number(year), Number(month) - 1, Number(day));
};
const formatShortDate = (date: Date) => {
  const month = date.toLocaleDateString('en-US', { month: 'short' }).toLowerCase();
  const day = String(date.getDate()).padStart(2, '0');
  return `${month} ${day} ${date.getFullYear()}`;
};


// A small fixed tilt per post, so the slips look set down by hand (and stay put between builds).
const tilt = (id: string) => {
  let h = 2166136261;
  for (const ch of id) h = Math.imul(h ^ ch.charCodeAt(0), 16777619);
  return `--tilt: ${((((h >>> 0) % 1000) / 1000) * 1.4 - 0.7).toFixed(2)}deg`;
};
---

<section class="home">
  {isDev && (
    <div class="dev-unpublished">
      <ol class="posts">
        {unpublished.map((post) => {
          const date = parseLocalDate(post.data.pubDate);
          return (
            <li class="post-row" style={tilt(post.id)}>
              <a href={`/blog/${post.id}`} class="post-link slip is-wip" target="_self">
                <span class="post-title">{post.data.title}</span>
                <span class="post-date">wip · <time datetime={post.data.pubDate}>{date ? formatShortDate(date) : post.data.pubDate}</time></span>
              </a>
              <button type="button" class="dev-row-action slip" data-dev-publish data-slug={post.id} data-publish="true" title="publish" aria-label="publish">↑</button>
              <a class="dev-row-action slip" href={`/editor?slug=${post.id}`} title="edit in the post editor" aria-label="edit">✎</a>
            </li>
          );
        })}
        <li class="post-row">
          <a class="dev-row-action dev-new slip" href="/editor">+ new post</a>
        </li>
      </ol>
    </div>
  )}

  <ol class="posts">
    {posts.map((post) => {
      const date = parseLocalDate(post.data.pubDate);
      return (
        <li class="post-row" style={tilt(post.id)}>
          <a href={`/blog/${post.id}`} class="post-link slip" target="_self">
            <span class="post-title">{post.data.title}</span>
            <time class="post-date" datetime={post.data.pubDate}>{date ? formatShortDate(date) : post.data.pubDate}</time>
          </a>
          {isDev && (
            <>
              <button type="button" class="dev-row-action slip" data-dev-publish data-slug={post.id} data-publish="false" title="unpublish" aria-label="unpublish">↓</button>
              <a class="dev-row-action slip" href={`/editor?slug=${post.id}`} title="edit in the post editor" aria-label="edit">✎</a>
            </>
          )}
        </li>
      );
    })}
  </ol>
</section>
{isDev && <DevPublishScript />}

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .post-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    max-width: min(100%, 40rem);
  }

  /* each post is its own slip, set down slightly askew */
  .post-link {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.15rem 1rem;
    padding: 0.45rem 0.85rem 0.5rem;
    min-width: 0;
    transform-origin: left center;
  }

  .post-row .post-link {
    transform: rotate(var(--tilt, 0deg));
  }

  .post-row .post-link:hover,
  .post-row .post-link:focus-visible {
    transform: rotate(0) translateX(6px);
    box-shadow: var(--paper-shadow-lift);
  }

  .post-title {
    font-family: var(--font-sans);
    font-size: 1.08rem;
    line-height: 1.35;
    min-width: 0;
  }

  .post-link:hover .post-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.03em;
    color: var(--paper-ink-soft);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* drafts: pencilled outline, not quite all there yet */
  .post-link.is-wip {
    outline: 1px dashed var(--paper-ink-soft);
    outline-offset: -4px;
    opacity: 0.85;
  }

  .post-link.is-wip:hover,
  .post-link.is-wip:focus-visible {
    opacity: 1;
  }

  /* dev only: small paper tabs tucked beside a slip */
  .dev-row-action {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1;
    border: 0;
    cursor: pointer;
    padding: 0.4rem 0.45rem;
    color: var(--paper-ink-soft);
    transform: rotate(calc(var(--tilt, 0deg) * -1.5));
  }

  .dev-row-action:hover,
  .dev-row-action:focus-visible {
    color: var(--paper-ink);
    transform: rotate(0) translateY(-1px);
  }

  /* the slip slides right on hover: the tabs move with it instead of being run into */
  .dev-row-action {
    transition: transform 0.18s ease, translate 0.18s ease, opacity 0.18s ease, box-shadow 0.18s ease;
  }

  .post-row:has(.post-link:hover) .dev-row-action,
  .post-row:has(.post-link:focus-visible) .dev-row-action {
    translate: 6px 0;
  }

  .dev-new {
    padding: 0.45rem 0.7rem;
  }

  /* with a pointer, the tabs stay out of the picture until you reach for a row */
  @media (hover: hover) {
    .post-row .dev-row-action:not(.dev-new) {
      opacity: 0;
    }

    .post-row:hover .dev-row-action,
    .post-row:focus-within .dev-row-action {
      opacity: 1;
    }
  }

  @media (max-width: 760px) {
    .posts {
      gap: 0.55rem;
    }

    .post-title {
      font-size: 1rem;
    }
  }
</style>
