---
// layout + content loading
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getCollection, render } from 'astro:content';
import galleryScriptUrl from '../../scripts/gallery.ts?url';
import diagramZoomScriptUrl from '../../scripts/diagram-zoom.ts?url';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.published);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter(heading => heading.depth >= 1 && heading.depth <= 3);
// Keep the contents component available, but default to distraction-free reading.
const tableOfContentsEnabled = false;
const showTableOfContents = tableOfContentsEnabled && tocHeadings.length >= 3;

const parseLocalDate = (dateString: string) => {
  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateString);
  if (!match) return null;
  const [, year, month, day] = match;
  return new Date(Number(year), Number(month) - 1, Number(day));
};
const parseIsoDate = (dateString?: string) => {
  if (!dateString) return undefined;
  const date = new Date(`${dateString}T00:00:00.000Z`);
  return Number.isNaN(date.getTime()) ? undefined : date.toISOString();
};
const publishedTime = parseIsoDate(post.data.pubDate);
const updatedTime = parseIsoDate(post.data.updatedDate);
const pubDate = parseLocalDate(post.data.pubDate);
const displayDate = pubDate
  ? pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).toLowerCase()
  : post.data.pubDate;
const description = post.data.description ?? 'a short post on something';
const body = typeof post.body === 'string' ? post.body.trim() : '';
const wordCount = body ? body.split(/\s+/).length : 0;
const readingTimeMinutes = post.data.readingTimeMinutes;
const readingTimeLabel = readingTimeMinutes < 60
  ? `approx ${readingTimeMinutes}m read`
  : `approx ${Math.floor(readingTimeMinutes / 60)}h${readingTimeMinutes % 60 ? ` ${readingTimeMinutes % 60}m` : ''} read`;
---
<style>
:root {
  --content-max-width: 700px;
  --side-gutter: 1rem;
}

/* code blocks scroll horizontally rather than wrapping (preserves indentation) */
pre {
  white-space: pre;
}

/* inline code may still break to avoid overflow */
:not(pre) > code {
  word-break: break-word;
  overflow-wrap: break-word;
}

/* body text line height */
.markdown-body {
  line-height: 1.8;
}

/* Post title styling */
.post-title-main {
  font-size: clamp(1.65rem, 4vw, 2.2rem);
  line-height: 1.25;
  margin: 0 0 0.85rem;
  font-weight: 600;
  letter-spacing: -0.04em;
  text-wrap: balance;
  overflow-wrap: anywhere;
  font-family: var(--font-mono);
  color: var(--fg-strong);
}

.post-description {
  color: var(--fg-soft);
  margin: 0;
  font-size: 0.98rem;
  line-height: 1.7;
  font-family: var(--font-mono);
}

.post-subline {
  padding-bottom: 1.75rem;
  margin-bottom: 1.75rem;
  border-bottom: 1px solid var(--border-soft);
}

.post-meta {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--fg-subtle);
  font-size: 0.75rem;
  letter-spacing: 0.01em;
  font-family: var(--font-mono);
  margin: 0 0 1rem;
}

.post-meta-sep {
  color: var(--border-strong);
}

.post-readtime {
  letter-spacing: 0.01em;
}

@media (max-width: 600px) {
  .post-subline {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .post-meta {
    flex-wrap: wrap;
  }
}

/* The layout owns the outside gutter; keep a single reading column. */
.centered-wrapper {
  width: 100%;
  min-width: 0;
}

article.post-plain :global(:is(h1, h2, h3)[id]) {
  scroll-margin-top: 3rem;
}

/* main article container */
article.post-plain {
  box-shadow: none;
  background: none;
  border: none;

  /* fluid width up to a max, centered */
  width: 100%;
  max-width: var(--content-max-width);
  margin: 2.5rem auto 3rem;
  padding: 0;
  box-sizing: border-box;
}

article.post-plain :global(img) {
  max-width: min(600px, 100%);
  width: 100%;
  height: auto;
  display: block;
  margin: 1.5rem auto;
}
article.post-plain :global(img[width]) {
  width: auto;
  max-width: 100%;
}

@media (max-width: 600px) {
  article.post-plain {
    margin-top: 1.5rem;
  }
  
  /* Better SVG handling for mobile */
  article.post-plain svg {
    height: auto !important;  /* Override any inline height */
    font-size: 12px !important; /* Slightly reduce SVG text size on mobile */
  }
}
</style>

<Layout
  title={post.data.title}
  description={description}
  ogType="article"
  useKatex={post.data.useKatex}
  ogImage={`/og/${post.id}.png`}
  schemaArticle={{
    title: post.data.title,
    description,
    publishedTime,
    updatedTime,
    section: post.data.cat,
    wordCount: wordCount || undefined,
    imageUrl: new URL(`/og/${post.id}.png`, Astro.site ?? 'https://anuraagw.me').href,
  }}
  schema={{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "home", "item": "https://anuraagw.me" },
      { "@type": "ListItem", "position": 2, "name": post.data.title },
    ],
  }}
>
  {showTableOfContents && <TableOfContents headings={tocHeadings} />}
  <div class="centered-wrapper">
    <article class="post-plain markdown-body">
      <div class="post-meta">
        <time datetime={post.data.pubDate}>{displayDate}</time>
        <span class="post-meta-sep">•</span>
        <span class="post-readtime">{readingTimeLabel}</span>
      </div>
      <h1 id="article-top" class="post-title-main">{post.data.title}</h1>
      <div class="post-subline">
        {post.data.description && (
          <p class="post-description">{post.data.description}</p>
        )}
      </div>
      <Content />
    </article>
  </div>
  <script type="module" src={galleryScriptUrl}></script>
  <script type="module" src={diagramZoomScriptUrl}></script>

</Layout>
