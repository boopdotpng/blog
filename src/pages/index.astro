---
import Layout from '../layouts/Layout.astro';
import Home from '../components/Home.astro';
import { getCollection } from 'astro:content';

const byDateDesc = (a: { data: { pubDate: string } }, b: { data: { pubDate: string } }) =>
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
const posts = await getCollection('blog', ({ data }) => data.published);
const sortedPosts = [...posts].sort(byDateDesc);
// Dev only: unpublished posts get their own section on the homepage.
const unpublishedPosts = import.meta.env.DEV
  ? (await getCollection('blog', ({ data }) => !data.published)).sort(byDateDesc)
  : [];
const site = Astro.site ?? new URL('https://anuraagw.me');
const homeUrl = new URL('/', site).toString();
const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${homeUrl}#collection`,
  url: homeUrl,
  name: 'boop — notes',
  description: 'Field notes on systems, ML, and GPUs, plus reverse engineering writeups and project updates.',
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: sortedPosts.length,
    itemListElement: sortedPosts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(`/blog/${post.id}`, site).toString(),
      name: post.data.title,
      description: post.data.description,
    })),
  },
};
const favoriteSong = {
  title: 'journey of a lifetime ~ frieren main theme',
  url: 'https://open.spotify.com/track/1FhWuo97KqSWbe4UYpKAei',
};

// Category legend for the sidebar — counts derived from posts, sorted by frequency.
const catCounts = sortedPosts.reduce<Record<string, number>>((acc, post) => {
  const cat = post.data.cat ?? 'misc';
  acc[cat] = (acc[cat] ?? 0) + 1;
  return acc;
}, {});
const categories = Object.entries(catCounts)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([name, count]) => ({ name, count }));

// Edit this line to change the "now" blurb in the sidebar.
const now = 'writing a tenstorrent backend for tinygrad';
---

<Layout
  title="notes on gpus, ml, and chips"
  description="Field notes on systems, ML, and GPUs, plus reverse engineering writeups and project updates."
  schema={homeSchema}
  favoriteSong={favoriteSong}
  categories={categories}
  now={now}
>
  <Home posts={sortedPosts} unpublished={unpublishedPosts} />
</Layout>
